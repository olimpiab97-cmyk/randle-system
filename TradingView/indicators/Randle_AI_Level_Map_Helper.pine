//@version=6
indicator("Randle AI - Level Map Helper v14 Canonical", overlay=true, max_lines_count=500)

//---------------------------------------------------------
// INPUTS
//---------------------------------------------------------
string tzInput = input.string("America/Los_Angeles", "Timezone")
bool useDst = input.bool(true, "US Daylight Savings Active")
string canonicalTimeZone = "America/Los_Angeles"

string londonSession    = useDst ? "0100-0500" : "0000-0500"
string premarketSession = input.session("0500-0615", "Pre-Market Session")
string overnightSession = input.session("1500-0615", "Overnight Session")
string rthSession       = input.session("0630-1300", "RTH Session (for YH/YL)")

bool showTable = input.bool(true, "Show Level Table")

bool showPMH = input.bool(true, "Show PMH")
bool showPML = input.bool(true, "Show PML")
bool showLH  = input.bool(true, "Show LH")
bool showLL  = input.bool(true, "Show LL")
bool showONH = input.bool(true, "Show ONH")
bool showONL = input.bool(true, "Show ONL")
bool showYH  = input.bool(true, "Show YH")
bool showYL  = input.bool(true, "Show YL")

bool stackOffset = input.bool(true, "Offset Stacked Levels")
int stackTicks   = input.int(8, "Stack Offset Ticks", minval=1, maxval=20)

float stackAtrPct = input.float(10.0, "Stack Group Threshold % of Daily ATR", minval=1.0, maxval=50.0)
bool showMidpoints = input.bool(true, "Show 50% Lines Between Non-Stacked Levels")
bool showExhaustion25 = input.bool(true, "Show 25% Remaining Exhaustion Lines")

//---------------------------------------------------------
// GLOBAL TICK / TOLERANCE HELPERS
//---------------------------------------------------------
float tick = syminfo.mintick
float tol  = tick * 0.25
float stackStep = tick * stackTicks

sameLevel(float a, float b) =>
    not na(a) and not na(b) and math.abs(a - b) <= tol

//---------------------------------------------------------
// SESSION HELPERS
//---------------------------------------------------------
inSession(string sess) =>
    not na(time(timeframe.period, sess, tzInput))

bool inLondon    = inSession(londonSession)
bool inPremarket = inSession(premarketSession)
bool inOvernight = inSession(overnightSession)
bool inRTH       = inSession(rthSession)

sessionStart(bool sessionState) =>
    sessionState and not sessionState[1]

sessionEnd(bool sessionState) =>
    not sessionState and sessionState[1]

// Fixed session timestamps for the chart day.
int today0615 = timestamp(tzInput, year, month, dayofmonth, 6, 15)
int today1400 = timestamp(tzInput, year, month, dayofmonth, 14, 0)
// OPERATIONAL_A_CADENCE=FROZEN_SNAPSHOT_5_MINUTE_RECOVERY
int recoveryCadenceMinutes = 5

bool before0615 = time < today0615
bool atOrAfter0615 = time >= today0615
bool before1400 = time <= today1400

bool newDay = dayofmonth(time, tzInput) != dayofmonth(time[1], tzInput) or month(time, tzInput) != month(time[1], tzInput) or year(time, tzInput) != year(time[1], tzInput)

// True only on the first confirmed bar that reaches or crosses 06:15.
// Covers normal running case.
bool firstBarAtOrAfter0615 = atOrAfter0615 and not atOrAfter0615[1]

// Late-start detector.
// If the script loads after 06:15, this lets the next confirmed bar freeze/send once.
bool shouldHaveSessionFrozen = atOrAfter0615

//---------------------------------------------------------
// SESSION TRACKERS
//---------------------------------------------------------

// London
var float londonHi = na
var float londonLo = na
var float lastLondonHi = na
var float lastLondonLo = na

if sessionStart(inLondon)
    londonHi := high
    londonLo := low
else if inLondon
    londonHi := math.max(nz(londonHi, high), high)
    londonLo := math.min(nz(londonLo, low), low)

if sessionEnd(inLondon)
    lastLondonHi := londonHi
    lastLondonLo := londonLo

// Pre-market
var float pmHi = na
var float pmLo = na
var float lastPmHi = na
var float lastPmLo = na

if sessionStart(inPremarket)
    pmHi := high
    pmLo := low
else if inPremarket
    pmHi := math.max(nz(pmHi, high), high)
    pmLo := math.min(nz(pmLo, low), low)

if sessionEnd(inPremarket)
    lastPmHi := pmHi
    lastPmLo := pmLo

// Overnight
var float onHi = na
var float onLo = na
var float lastOnHi = na
var float lastOnLo = na

if sessionStart(inOvernight)
    onHi := high
    onLo := low
else if inOvernight
    onHi := math.max(nz(onHi, high), high)
    onLo := math.min(nz(onLo, low), low)

if sessionEnd(inOvernight)
    lastOnHi := onHi
    lastOnLo := onLo

// Prior RTH high/low
var float rthHi = na
var float rthLo = na
var float prevRthHi = na
var float prevRthLo = na

if sessionStart(inRTH)
    rthHi := high
    rthLo := low
else if inRTH
    rthHi := math.max(nz(rthHi, high), high)
    rthLo := math.min(nz(rthLo, low), low)

if sessionEnd(inRTH)
    prevRthHi := rthHi
    prevRthLo := rthLo

//---------------------------------------------------------
// RAW LEVEL VALUES
//---------------------------------------------------------
float LH_base  = inLondon ? londonHi : lastLondonHi
float LL_raw   = inLondon ? londonLo : lastLondonLo

float PMH_raw = inPremarket ? pmHi : lastPmHi
float PML_raw = inPremarket ? pmLo : lastPmLo

float ONH_raw = inOvernight ? onHi : lastOnHi
float ONL_raw = inOvernight ? onLo : lastOnLo

float YH_raw = prevRthHi
float YL_raw = prevRthLo

//---------------------------------------------------------
// LH PROMOTION LOGIC
//---------------------------------------------------------
bool newPMHBar = not na(PMH_raw) and (na(PMH_raw[1]) or PMH_raw > PMH_raw[1] + tol)
bool newONHBar = not na(ONH_raw) and (na(ONH_raw[1]) or ONH_raw > ONH_raw[1] + tol)

bool lhWickOnlySweep = not inLondon and not na(lastLondonHi) and high > lastLondonHi and close <= lastLondonHi
bool lhPromoteThisBar = lhWickOnlySweep and newPMHBar and newONHBar and sameLevel(high, PMH_raw) and sameLevel(high, ONH_raw)

var float lhPromotedHi = na

if newDay or sessionStart(inLondon) or sessionEnd(inLondon)
    lhPromotedHi := na

if lhPromoteThisBar
    lhPromotedHi := high

float LH_raw = not na(lhPromotedHi) ? lhPromotedHi : LH_base

//---------------------------------------------------------
// DAILY ATR / RANGE METRICS
//---------------------------------------------------------
float dailyATR14 = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead=barmerge.lookahead_off)
float atr1m14 = ta.atr(14)

float pmRange = na(PMH_raw) or na(PML_raw) ? na : (PMH_raw - PML_raw)
float pmATRpct = na(pmRange) or na(dailyATR14) or dailyATR14 == 0 ? na : (pmRange / dailyATR14) * 100.0

float onRange = na(ONH_raw) or na(ONL_raw) ? na : (ONH_raw - ONL_raw)
float dailyRangePct = na(onRange) or na(dailyATR14) or dailyATR14 == 0 ? na : (onRange / dailyATR14) * 100.0

float stackThresholdRaw = na(dailyATR14) or dailyATR14 == 0 ? na : dailyATR14 * (stackAtrPct / 100.0)

fmtPct(float x) =>
    na(x) ? "na" : str.tostring(x, "#.0") + "%"

fmt(float x) =>
    na(x) ? "na" : str.tostring(x, format.mintick)

roundToMintick(float x) =>
    na(x) ? na : math.round(x / syminfo.mintick) * syminfo.mintick

float stackThreshold = roundToMintick(stackThresholdRaw)

sessionStateText(bool state) =>
    state ? "LIVE" : "SET"

//---------------------------------------------------------
// 5-MIN DATA FOR BREAK-THROUGH LOGIC
//---------------------------------------------------------
float close5 = request.security(syminfo.tickerid, "5", close, lookahead=barmerge.lookahead_off)
int   time5  = request.security(syminfo.tickerid, "5", time,  lookahead=barmerge.lookahead_off)
bool  new5ConfirmedBar = ta.change(time5) != 0

//---------------------------------------------------------
// STATUS ENGINE
//---------------------------------------------------------
var bool lhInactive = false
var bool llInactive = false

if sessionEnd(inLondon)
    lhInactive := false
    llInactive := false

if not na(LH_raw) and not inLondon and not lhInactive and close > LH_raw
    lhInactive := true

if not na(lastLondonLo) and not inLondon and not llInactive and close < lastLondonLo
    llInactive := true

var bool onhReactivated = false
var bool onhInactive = false
var bool onlReactivated = false
var bool onlInactive = false
var bool yhReactivated = false
var bool yhInactive = false
var bool ylReactivated = false
var bool ylInactive = false

bool newONH = not na(ONH_raw) and (na(ONH_raw[1]) or ONH_raw != ONH_raw[1])
bool newONL = not na(ONL_raw) and (na(ONL_raw[1]) or ONL_raw != ONL_raw[1])
bool newYH  = not na(YH_raw)  and (na(YH_raw[1])  or YH_raw != YH_raw[1])
bool newYL  = not na(YL_raw)  and (na(YL_raw[1])  or YL_raw != YL_raw[1])

if newONH
    onhReactivated := false
    onhInactive := false
if newONL
    onlReactivated := false
    onlInactive := false
if newYH
    yhReactivated := false
    yhInactive := false
if newYL
    ylReactivated := false
    ylInactive := false

if not na(ONH_raw) and not onhReactivated and not onhInactive and new5ConfirmedBar and close5 > ONH_raw
    onhReactivated := true
if not na(ONL_raw) and not onlReactivated and not onlInactive and new5ConfirmedBar and close5 < ONL_raw
    onlReactivated := true
if not na(YH_raw) and not yhReactivated and not yhInactive and new5ConfirmedBar and close5 > YH_raw
    yhReactivated := true
if not na(YL_raw) and not ylReactivated and not ylInactive and new5ConfirmedBar and close5 < YL_raw
    ylReactivated := true

if onhReactivated and not onhInactive and close < ONH_raw
    onhInactive := true
if onlReactivated and not onlInactive and close > ONL_raw
    onlInactive := true
if yhReactivated and not yhInactive and close < YH_raw
    yhInactive := true
if ylReactivated and not ylInactive and close > YL_raw
    ylInactive := true

string pmhStatus = "ACTIVE"
string pmlStatus = "ACTIVE"
string lhStatus  = lhInactive ? "INACTIVE" : "ACTIVE"
string llStatus  = llInactive ? "INACTIVE" : "ACTIVE"
string onhStatus = onhInactive ? "INACTIVE" : onhReactivated ? "REACTIVATED" : "ACTIVE"
string onlStatus = onlInactive ? "INACTIVE" : onlReactivated ? "REACTIVATED" : "ACTIVE"
string yhStatus  = yhInactive ? "INACTIVE" : yhReactivated ? "REACTIVATED" : "ACTIVE"
string ylStatus  = ylInactive ? "INACTIVE" : ylReactivated ? "REACTIVATED" : "ACTIVE"

//---------------------------------------------------------
// SESSION-END LOCK
//---------------------------------------------------------

// Session state
var bool sessionLocked = false
var bool sessionTableFrozen = false
var bool sessionTableSent = false
var string frozenCanonicalPayload = ""
var string frozenCanonicalSourceTimestamp = ""
var int lastRecoveryDeliveryBarTime = na

// Frozen level values
var float LH_lock  = na
var float LL_lock  = na
var float PMH_lock = na
var float PML_lock = na
var float ONH_lock = na
var float ONL_lock = na
var float YH_lock  = na
var float YL_lock  = na
var float stackThreshold_lock = na
var float sessionLockPrice_lock = na
var int sessionTradingDay_lock = na

// Frozen statuses
var string lhStatus_lock  = "ACTIVE"
var string llStatus_lock  = "ACTIVE"
var string pmhStatus_lock = "ACTIVE"
var string pmlStatus_lock = "ACTIVE"
var string onhStatus_lock = "ACTIVE"
var string onlStatus_lock = "ACTIVE"
var string yhStatus_lock  = "ACTIVE"
var string ylStatus_lock  = "ACTIVE"

// Reset every session
if newDay
    sessionLocked := false
    sessionTableFrozen := false
    sessionTableSent := false
    frozenCanonicalPayload := ""
    frozenCanonicalSourceTimestamp := ""
    lastRecoveryDeliveryBarTime := na

    LH_lock  := na
    LL_lock  := na
    PMH_lock := na
    PML_lock := na
    ONH_lock := na
    ONL_lock := na
    YH_lock  := na
    YL_lock  := na
    stackThreshold_lock := na
    sessionLockPrice_lock := na
    sessionTradingDay_lock := na

// Freeze exactly once.
// Either:
// 1) normal 06:15 transition
// 2) script started after 06:15 and table hasn't been frozen yet.
bool shouldFreezeNow =
     not sessionTableFrozen and
     (
         sessionEnd(inPremarket) or
         (shouldHaveSessionFrozen and not sessionLocked)
     )

if shouldFreezeNow
    sessionLocked := true
    sessionTableFrozen := true

    LH_lock  := LH_raw
    LL_lock  := LL_raw
    PMH_lock := lastPmHi
    PML_lock := lastPmLo
    ONH_lock := lastOnHi
    ONL_lock := lastOnLo
    YH_lock  := prevRthHi
    YL_lock  := prevRthLo
    stackThreshold_lock := stackThreshold
    sessionLockPrice_lock := close
    sessionTradingDay_lock := time_tradingday

    lhStatus_lock  := lhStatus
    llStatus_lock  := llStatus
    pmhStatus_lock := pmhStatus
    pmlStatus_lock := pmlStatus
    onhStatus_lock := onhStatus
    onlStatus_lock := onlStatus
    yhStatus_lock  := yhStatus
    ylStatus_lock  := ylStatus

float LH_eff  = sessionLocked ? LH_lock  : LH_raw
float LL_eff  = sessionLocked ? LL_lock  : LL_raw
float PMH_eff = sessionLocked ? PMH_lock : PMH_raw
float PML_eff = sessionLocked ? PML_lock : PML_raw
float ONH_eff = sessionLocked ? ONH_lock : ONH_raw
float ONL_eff = sessionLocked ? ONL_lock : ONL_raw
float YH_eff  = sessionLocked ? YH_lock  : YH_raw
float YL_eff  = sessionLocked ? YL_lock  : YL_raw
float stackThreshold_eff = sessionLocked ? stackThreshold_lock : stackThreshold
float sessionLockPrice_eff = sessionLocked ? sessionLockPrice_lock : na

string lhStatus_eff  = sessionLocked ? lhStatus_lock  : lhStatus
string llStatus_eff  = sessionLocked ? llStatus_lock  : llStatus
string pmhStatus_eff = sessionLocked ? pmhStatus_lock : pmhStatus
string pmlStatus_eff = sessionLocked ? pmlStatus_lock : pmlStatus
string onhStatus_eff = sessionLocked ? onhStatus_lock : onhStatus
string onlStatus_eff = sessionLocked ? onlStatus_lock : onlStatus
string yhStatus_eff  = sessionLocked ? yhStatus_lock  : yhStatus
string ylStatus_eff  = sessionLocked ? ylStatus_lock  : ylStatus

//---------------------------------------------------------
// STACK GROUP LOGIC - FINAL MERGED COMPONENT STACKS
//---------------------------------------------------------

groupLabel(float price) =>
    if na(price)
        "NONE"
    else if price > close
        "HIGH"
    else if price < close
        "LOW"
    else
        "TOUCH"

var int[] stackLevelGroups = array.new_int()
var int[] stackLevelBridgeGroups = array.new_int()
var int[] stackCounts = array.new_int()
var float[] stackOuterPrices = array.new_float()
var float[] stackInnerPrices = array.new_float()
var string[] stackSides = array.new_string()

var int[] frozenStackLevelGroups = array.new_int()
var int[] frozenStackLevelBridgeGroups = array.new_int()
var int[] frozenStackCounts = array.new_int()
var float[] frozenStackOuterPrices = array.new_float()
var float[] frozenStackInnerPrices = array.new_float()
var string[] frozenStackSides = array.new_string()

levelActive(float price, string status) =>
    not na(price) and status != "INACTIVE" and (groupLabel(price) == "HIGH" or groupLabel(price) == "LOW")

priceAtIndex(int idx) =>
    switch idx
        0 => YH_eff
        1 => YL_eff
        2 => ONH_eff
        3 => ONL_eff
        4 => LH_eff
        5 => LL_eff
        6 => PMH_eff
        7 => PML_eff
        => na

statusAtIndex(int idx) =>
    switch idx
        0 => yhStatus_eff
        1 => ylStatus_eff
        2 => onhStatus_eff
        3 => onlStatus_eff
        4 => lhStatus_eff
        5 => llStatus_eff
        6 => pmhStatus_eff
        7 => pmlStatus_eff
        => "INACTIVE"

sideAtIndex(int idx) =>
    groupLabel(priceAtIndex(idx))

clearLiveStacks() =>
    array.clear(stackLevelGroups)
    array.clear(stackLevelBridgeGroups)
    array.clear(stackCounts)
    array.clear(stackOuterPrices)
    array.clear(stackInnerPrices)
    array.clear(stackSides)

clearFrozenStacks() =>
    array.clear(frozenStackLevelGroups)
    array.clear(frozenStackLevelBridgeGroups)
    array.clear(frozenStackCounts)
    array.clear(frozenStackOuterPrices)
    array.clear(frozenStackInnerPrices)
    array.clear(frozenStackSides)

restoreFrozenStacks() =>
    clearLiveStacks()

    int frozenGroupCount = array.size(frozenStackLevelGroups)
    if frozenGroupCount > 0
        for i = 0 to frozenGroupCount - 1
            array.push(stackLevelGroups, array.get(frozenStackLevelGroups, i))
            array.push(stackLevelBridgeGroups, array.get(frozenStackLevelBridgeGroups, i))

    int frozenCountCount = array.size(frozenStackCounts)
    if frozenCountCount > 0
        for i = 0 to frozenCountCount - 1
            array.push(stackCounts, array.get(frozenStackCounts, i))
            array.push(stackOuterPrices, array.get(frozenStackOuterPrices, i))
            array.push(stackInnerPrices, array.get(frozenStackInnerPrices, i))
            array.push(stackSides, array.get(frozenStackSides, i))

sortStackSideArrays(int[] idxArr, float[] priceArr, bool ascending) =>
    int n = array.size(priceArr)

    if n > 1
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                float pi = array.get(priceArr, i)
                float pj = array.get(priceArr, j)

                bool shouldSwap = ascending ? pj < pi : pj > pi

                if shouldSwap
                    int idxI = array.get(idxArr, i)
                    int idxJ = array.get(idxArr, j)

                    array.set(priceArr, i, pj)
                    array.set(priceArr, j, pi)
                    array.set(idxArr, i, idxJ)
                    array.set(idxArr, j, idxI)

commitFullSpanCandidate(int[] candidateIdx, float[] candidatePrices, string side) =>
    int count = array.size(candidateIdx)
    if count >= 2
        float innermostLiquidityLevel = array.get(candidatePrices, 0)
        float outermostLiquidityLevel = array.get(candidatePrices, count - 1)
        array.push(stackCounts, count)
        array.push(stackOuterPrices, outermostLiquidityLevel)
        array.push(stackInnerPrices, innermostLiquidityLevel)
        array.push(stackSides, side)

        int groupId = array.size(stackCounts)
        for i = 0 to count - 1
            int levelIdx = array.get(candidateIdx, i)
            int primaryGroupId = array.get(stackLevelGroups, levelIdx)
            int bridgeGroupId = array.get(stackLevelBridgeGroups, levelIdx)

            if primaryGroupId == 0
                array.set(stackLevelGroups, levelIdx, groupId)
            else if primaryGroupId != groupId and bridgeGroupId == 0
                array.set(stackLevelBridgeGroups, levelIdx, groupId)
            else if primaryGroupId != groupId and bridgeGroupId != groupId
                runtime.error("STACK_MEMBERSHIP_OVERFLOW")

buildFullSpanSide(int[] sideIdx, float[] sidePrices, string side) =>
    int sideCount = array.size(sidePrices)
    if sideCount > 0
        int[] candidateIdx = array.new_int()
        float[] candidatePrices = array.new_float()
        float candidateLowest = na
        float candidateHighest = na

        for i = 0 to sideCount - 1
            int nextIdx = array.get(sideIdx, i)
            float nextPrice = array.get(sidePrices, i)
            float proposedLowest = na(candidateLowest) ? nextPrice : math.min(candidateLowest, nextPrice)
            float proposedHighest = na(candidateHighest) ? nextPrice : math.max(candidateHighest, nextPrice)
            bool proposedSpanValid = not na(stackThreshold) and proposedHighest - proposedLowest <= stackThreshold

            if array.size(candidateIdx) == 0 or proposedSpanValid
                array.push(candidateIdx, nextIdx)
                array.push(candidatePrices, nextPrice)
                candidateLowest := proposedLowest
                candidateHighest := proposedHighest
            else
                int priorCount = array.size(candidateIdx)
                float bridgePrice = array.get(candidatePrices, priorCount - 1)
                commitFullSpanCandidate(candidateIdx, candidatePrices, side)
                array.clear(candidateIdx)
                array.clear(candidatePrices)

                bool bridgeSpanValid = not na(stackThreshold) and math.abs(nextPrice - bridgePrice) <= stackThreshold
                if bridgeSpanValid
                    // Every active level at the preceding outer boundary carries
                    // into the next stack, preserving reciprocal bridge ownership.
                    for bridgeIndex = 0 to priorCount - 1
                        float priorPrice = array.get(sidePrices, i - priorCount + bridgeIndex)
                        if priorPrice == bridgePrice
                            array.push(candidateIdx, array.get(sideIdx, i - priorCount + bridgeIndex))
                            array.push(candidatePrices, priorPrice)

                    array.push(candidateIdx, nextIdx)
                    array.push(candidatePrices, nextPrice)
                    candidateLowest := math.min(bridgePrice, nextPrice)
                    candidateHighest := math.max(bridgePrice, nextPrice)
                else
                    array.push(candidateIdx, nextIdx)
                    array.push(candidatePrices, nextPrice)
                    candidateLowest := nextPrice
                    candidateHighest := nextPrice

        commitFullSpanCandidate(candidateIdx, candidatePrices, side)

buildLiveStacks() =>
    clearLiveStacks()

    for i = 0 to 7
        array.push(stackLevelGroups, 0)
        array.push(stackLevelBridgeGroups, 0)

    int[] highIdx = array.new_int()
    float[] highPrices = array.new_float()
    int[] lowIdx = array.new_int()
    float[] lowPrices = array.new_float()

    for i = 0 to 7
        float p = priceAtIndex(i)
        string st = statusAtIndex(i)
        string side = sideAtIndex(i)

        if levelActive(p, st)
            if side == "HIGH"
                array.push(highIdx, i)
                array.push(highPrices, p)
            if side == "LOW"
                array.push(lowIdx, i)
                array.push(lowPrices, p)

    int highCount = array.size(highPrices)
    if highCount > 0
        sortStackSideArrays(highIdx, highPrices, true)
        buildFullSpanSide(highIdx, highPrices, "HIGH")

    int lowCount = array.size(lowPrices)
    if lowCount > 0
        sortStackSideArrays(lowIdx, lowPrices, false)
        buildFullSpanSide(lowIdx, lowPrices, "LOW")

freezeStacks() =>
    clearFrozenStacks()

    int groupCount = array.size(stackLevelGroups)
    if groupCount > 0
        for i = 0 to groupCount - 1
            array.push(frozenStackLevelGroups, array.get(stackLevelGroups, i))
            array.push(frozenStackLevelBridgeGroups, array.get(stackLevelBridgeGroups, i))

    int stackCount = array.size(stackCounts)
    if stackCount > 0
        for i = 0 to stackCount - 1
            array.push(frozenStackCounts, array.get(stackCounts, i))
            array.push(frozenStackOuterPrices, array.get(stackOuterPrices, i))
            array.push(frozenStackInnerPrices, array.get(stackInnerPrices, i))
            array.push(frozenStackSides, array.get(stackSides, i))

if not sessionTableFrozen or shouldFreezeNow
    buildLiveStacks()

if shouldFreezeNow
    freezeStacks()

if sessionTableFrozen and not shouldFreezeNow
    restoreFrozenStacks()

int yhGroup  = array.size(stackLevelGroups) > 0 ? array.get(stackLevelGroups, 0) : 0
int ylGroup  = array.size(stackLevelGroups) > 1 ? array.get(stackLevelGroups, 1) : 0
int onhGroup = array.size(stackLevelGroups) > 2 ? array.get(stackLevelGroups, 2) : 0
int onlGroup = array.size(stackLevelGroups) > 3 ? array.get(stackLevelGroups, 3) : 0
int lhGroup  = array.size(stackLevelGroups) > 4 ? array.get(stackLevelGroups, 4) : 0
int llGroup  = array.size(stackLevelGroups) > 5 ? array.get(stackLevelGroups, 5) : 0
int pmhGroup = array.size(stackLevelGroups) > 6 ? array.get(stackLevelGroups, 6) : 0
int pmlGroup = array.size(stackLevelGroups) > 7 ? array.get(stackLevelGroups, 7) : 0

int yhBridgeGroup  = array.size(stackLevelBridgeGroups) > 0 ? array.get(stackLevelBridgeGroups, 0) : 0
int ylBridgeGroup  = array.size(stackLevelBridgeGroups) > 1 ? array.get(stackLevelBridgeGroups, 1) : 0
int onhBridgeGroup = array.size(stackLevelBridgeGroups) > 2 ? array.get(stackLevelBridgeGroups, 2) : 0
int onlBridgeGroup = array.size(stackLevelBridgeGroups) > 3 ? array.get(stackLevelBridgeGroups, 3) : 0
int lhBridgeGroup  = array.size(stackLevelBridgeGroups) > 4 ? array.get(stackLevelBridgeGroups, 4) : 0
int llBridgeGroup  = array.size(stackLevelBridgeGroups) > 5 ? array.get(stackLevelBridgeGroups, 5) : 0
int pmhBridgeGroup = array.size(stackLevelBridgeGroups) > 6 ? array.get(stackLevelBridgeGroups, 6) : 0
int pmlBridgeGroup = array.size(stackLevelBridgeGroups) > 7 ? array.get(stackLevelBridgeGroups, 7) : 0

priceStackCount(int groupId) =>
    groupId == 0 ? 0 : array.get(stackCounts, groupId - 1)

priceStackAnchor(int groupId) =>
    groupId == 0 ? na : array.get(stackOuterPrices, groupId - 1)

priceStackInner(int groupId) =>
    groupId == 0 ? na : array.get(stackInnerPrices, groupId - 1)

priceStackSide(int groupId) =>
    groupId == 0 ? "NONE" : array.get(stackSides, groupId - 1)

cleanStackLabel(int groupId) =>
    if groupId == 0 or priceStackCount(groupId) < 2
        "NONE"
    else
        string side = priceStackSide(groupId)
        float thisInnerLiquidityLevel = priceStackInner(groupId)
        int sideNumber = 1

        int stackTotal = array.size(stackCounts)
        if stackTotal > 0
            for i = 0 to stackTotal - 1
                int otherGroupId = i + 1
                string otherSide = priceStackSide(otherGroupId)
                float otherInnerLiquidityLevel = priceStackInner(otherGroupId)

                if otherGroupId != groupId and otherSide == side
                    if side == "HIGH" and otherInnerLiquidityLevel < thisInnerLiquidityLevel
                        sideNumber += 1
                    if side == "LOW" and otherInnerLiquidityLevel > thisInnerLiquidityLevel
                        sideNumber += 1

        side == "HIGH" ? "HIGH " + str.tostring(sideNumber) :
         side == "LOW" ? "LOW " + str.tostring(sideNumber) :
         "TOUCH"

stackLabelForLevel(int idx) =>
    int groupId = array.size(stackLevelGroups) > idx ? array.get(stackLevelGroups, idx) : 0
    cleanStackLabel(groupId)

stackDisplayForLevel(int idx) =>
    int primaryGroupId = array.size(stackLevelGroups) > idx ? array.get(stackLevelGroups, idx) : 0
    int bridgeGroupId = array.size(stackLevelBridgeGroups) > idx ? array.get(stackLevelBridgeGroups, idx) : 0
    string primaryLabel = cleanStackLabel(primaryGroupId)
    string bridgeLabel = cleanStackLabel(bridgeGroupId)

    primaryLabel == "NONE" ? bridgeLabel :
     bridgeLabel == "NONE" ? primaryLabel :
     primaryLabel + " + " + bridgeLabel

string yhStackGroup_raw  = stackDisplayForLevel(0)
string ylStackGroup_raw  = stackDisplayForLevel(1)
string onhStackGroup_raw = stackDisplayForLevel(2)
string onlStackGroup_raw = stackDisplayForLevel(3)
string lhStackGroup_raw  = stackDisplayForLevel(4)
string llStackGroup_raw  = stackDisplayForLevel(5)
string pmhStackGroup_raw = stackDisplayForLevel(6)
string pmlStackGroup_raw = stackDisplayForLevel(7)

var string yhStackGroup_lock  = "NONE"
var string ylStackGroup_lock  = "NONE"
var string onhStackGroup_lock = "NONE"
var string onlStackGroup_lock = "NONE"
var string lhStackGroup_lock  = "NONE"
var string llStackGroup_lock  = "NONE"
var string pmhStackGroup_lock = "NONE"
var string pmlStackGroup_lock = "NONE"

if shouldFreezeNow
    yhStackGroup_lock  := yhStackGroup_raw
    ylStackGroup_lock  := ylStackGroup_raw
    onhStackGroup_lock := onhStackGroup_raw
    onlStackGroup_lock := onlStackGroup_raw
    lhStackGroup_lock  := lhStackGroup_raw
    llStackGroup_lock  := llStackGroup_raw
    pmhStackGroup_lock := pmhStackGroup_raw
    pmlStackGroup_lock := pmlStackGroup_raw

string yhStackGroup  = sessionLocked ? yhStackGroup_lock  : yhStackGroup_raw
string ylStackGroup  = sessionLocked ? ylStackGroup_lock  : ylStackGroup_raw
string onhStackGroup = sessionLocked ? onhStackGroup_lock : onhStackGroup_raw
string onlStackGroup = sessionLocked ? onlStackGroup_lock : onlStackGroup_raw
string lhStackGroup  = sessionLocked ? lhStackGroup_lock  : lhStackGroup_raw
string llStackGroup  = sessionLocked ? llStackGroup_lock  : llStackGroup_raw
string pmhStackGroup = sessionLocked ? pmhStackGroup_lock : pmhStackGroup_raw
string pmlStackGroup = sessionLocked ? pmlStackGroup_lock : pmlStackGroup_raw

//---------------------------------------------------------
// DYNAMIC LADDER / EXHAUSTION BOUNDARY HELPERS
//---------------------------------------------------------

isStackedGroup(string stackLabel) =>
    stackLabel != "NONE"

stackSideOuterHigh(int groupId) =>
    priceStackAnchor(groupId)

stackSideOuterLow(int groupId) =>
    priceStackAnchor(groupId)

// Canonical stack labels may overlap through a dual-member level.  Resolve
// that graph before choosing an endpoint; display labels and JSON order are
// never boundary authority.
stackComponentMask(int primaryGroupId, int bridgeGroupId) =>
    int stackTotal = array.size(stackCounts)
    bool[] component = array.new_bool(stackTotal, false)
    if primaryGroupId > 0 and primaryGroupId <= stackTotal
        array.set(component, primaryGroupId - 1, true)
    if bridgeGroupId > 0 and bridgeGroupId <= stackTotal
        array.set(component, bridgeGroupId - 1, true)

    if stackTotal > 0
        for passIndex = 0 to stackTotal - 1
            for levelIdx = 0 to 7
                int levelPrimary = array.size(stackLevelGroups) > levelIdx ? array.get(stackLevelGroups, levelIdx) : 0
                int levelBridge = array.size(stackLevelBridgeGroups) > levelIdx ? array.get(stackLevelBridgeGroups, levelIdx) : 0
                bool primaryIncluded = levelPrimary > 0 and levelPrimary <= stackTotal and array.get(component, levelPrimary - 1)
                bool bridgeIncluded = levelBridge > 0 and levelBridge <= stackTotal and array.get(component, levelBridge - 1)
                if primaryIncluded or bridgeIncluded
                    if levelPrimary > 0 and levelPrimary <= stackTotal
                        array.set(component, levelPrimary - 1, true)
                    if levelBridge > 0 and levelBridge <= stackTotal
                        array.set(component, levelBridge - 1, true)
    component

stackComponentKey(int primaryGroupId, int bridgeGroupId) =>
    bool[] component = stackComponentMask(primaryGroupId, bridgeGroupId)
    int ownerId = 0
    int stackTotal = array.size(component)
    if stackTotal > 0
        for i = 0 to stackTotal - 1
            if array.get(component, i) and ownerId == 0
                ownerId := i + 1
    ownerId == 0 ? "NONE" : "STACK_COMPONENT_" + str.tostring(ownerId)

stackComponentExtreme(int primaryGroupId, int bridgeGroupId, string side, float fallbackPrice) =>
    bool[] component = stackComponentMask(primaryGroupId, bridgeGroupId)
    float extreme = na
    int stackTotal = array.size(component)
    if stackTotal > 0
        for i = 0 to stackTotal - 1
            if array.get(component, i)
                float candidate = priceStackAnchor(i + 1)
                if not na(candidate)
                    extreme := na(extreme) ? candidate : side == "HIGH" ? math.max(extreme, candidate) : math.min(extreme, candidate)
    na(extreme) ? fallbackPrice : extreme

//---------------------------------------------------------
// DYNAMIC LADDER ARRAYS
//---------------------------------------------------------

var string[] highNames = array.new_string()
var float[] highAnchorPrices = array.new_float()
var float[] highTargetPrices = array.new_float()
var string[] highStackLabels = array.new_string()
var bool[] highIsStack = array.new_bool()

var string[] lowNames = array.new_string()
var float[] lowAnchorPrices = array.new_float()
var float[] lowTargetPrices = array.new_float()
var string[] lowStackLabels = array.new_string()
var bool[] lowIsStack = array.new_bool()

var string[] frozenHighNames = array.new_string()
var float[] frozenHighPrices = array.new_float()

var string[] frozenLowNames = array.new_string()
var float[] frozenLowPrices = array.new_float()

clearLiveLadder() =>
    array.clear(highNames)
    array.clear(highAnchorPrices)
    array.clear(highTargetPrices)
    array.clear(highStackLabels)
    array.clear(highIsStack)

    array.clear(lowNames)
    array.clear(lowAnchorPrices)
    array.clear(lowTargetPrices)
    array.clear(lowStackLabels)
    array.clear(lowIsStack)

clearFrozenLadder() =>
    array.clear(frozenHighNames)
    array.clear(frozenHighPrices)
    array.clear(frozenLowNames)
    array.clear(frozenLowPrices)

clearLiveLadder()

//---------------------------------------------------------
// HIGH LADDER BUILDER
//---------------------------------------------------------

addHighLevel(string name, float price, string status, string stackLabel, int groupId, int bridgeGroupId, bool fixedSide) =>
    if not na(price) and status != "INACTIVE" and (fixedSide or price > close)

        bool isStack = groupId > 0 or bridgeGroupId > 0

        float anchor =
             isStack
             ? stackComponentExtreme(groupId, bridgeGroupId, "HIGH", price)
             : price

        string ownerKey = isStack ? stackComponentKey(groupId, bridgeGroupId) : "LEVEL_" + name

        bool alreadyExists = false

        int highStackCount = array.size(highStackLabels)

        if highStackCount > 0
            for i = 0 to highStackCount - 1
                if array.get(highStackLabels, i) == ownerKey
                    alreadyExists := true

        if not alreadyExists
            array.push(highNames, name)
            array.push(highAnchorPrices, anchor)
            array.push(highTargetPrices, na)
            array.push(highStackLabels, ownerKey)
            array.push(highIsStack, isStack)

//---------------------------------------------------------
// LOW LADDER BUILDER
//---------------------------------------------------------

addLowLevel(string name, float price, string status, string stackLabel, int groupId, int bridgeGroupId, bool fixedSide) =>
    if not na(price) and status != "INACTIVE" and (fixedSide or price < close)

        bool isStack = groupId > 0 or bridgeGroupId > 0

        float anchor =
             isStack
             ? stackComponentExtreme(groupId, bridgeGroupId, "LOW", price)
             : price

        string ownerKey = isStack ? stackComponentKey(groupId, bridgeGroupId) : "LEVEL_" + name

        bool alreadyExists = false

        int lowStackCount = array.size(lowStackLabels)

        if lowStackCount > 0
            for i = 0 to lowStackCount - 1
                if array.get(lowStackLabels, i) == ownerKey
                    alreadyExists := true

        if not alreadyExists
            array.push(lowNames, name)
            array.push(lowAnchorPrices, anchor)
            array.push(lowTargetPrices, na)
            array.push(lowStackLabels, ownerKey)
            array.push(lowIsStack, isStack)
//---------------------------------------------------------
// SORT HIGH LADDER (NEAREST ABOVE → OUTWARD)
//---------------------------------------------------------

sortHighLadder() =>
    int n = array.size(highAnchorPrices)

    if n > 1
        for i = 0 to n - 2
            for j = i + 1 to n - 1

                float pi = array.get(highAnchorPrices, i)
                float pj = array.get(highAnchorPrices, j)

                if pj < pi

                    string ni = array.get(highNames, i)
                    string nj = array.get(highNames, j)

                    float ai = array.get(highAnchorPrices, i)
                    float aj = array.get(highAnchorPrices, j)

                    float ti = array.get(highTargetPrices, i)
                    float tj = array.get(highTargetPrices, j)

                    string si = array.get(highStackLabels, i)
                    string sj = array.get(highStackLabels, j)

                    bool bi = array.get(highIsStack, i)
                    bool bj = array.get(highIsStack, j)

                    array.set(highNames, i, nj)
                    array.set(highNames, j, ni)

                    array.set(highAnchorPrices, i, aj)
                    array.set(highAnchorPrices, j, ai)

                    array.set(highTargetPrices, i, tj)
                    array.set(highTargetPrices, j, ti)

                    array.set(highStackLabels, i, sj)
                    array.set(highStackLabels, j, si)

                    array.set(highIsStack, i, bj)
                    array.set(highIsStack, j, bi)

//---------------------------------------------------------
// POPULATE HIGH / LOW LADDER
//---------------------------------------------------------

// Fixed-side high levels
addHighLevel("PMH", PMH_eff, pmhStatus_eff, pmhStackGroup, pmhGroup, pmhBridgeGroup, true)
addHighLevel("LH",  LH_eff,  lhStatus_eff,  lhStackGroup,  lhGroup,  lhBridgeGroup,  true)
addHighLevel("ONH", ONH_eff, onhStatus_eff, onhStackGroup, onhGroup, onhBridgeGroup, true)

// Fixed-side low levels
addLowLevel("PML", PML_eff, pmlStatus_eff, pmlStackGroup, pmlGroup, pmlBridgeGroup, true)
addLowLevel("LL",  LL_eff,  llStatus_eff,  llStackGroup,  llGroup,  llBridgeGroup,  true)
addLowLevel("ONL", ONL_eff, onlStatus_eff, onlStackGroup, onlGroup, onlBridgeGroup, true)

// YH / YL are roamers.
// Admit them to whichever side of current price they actually occupy.
// addHighLevel() only accepts price > close.
// addLowLevel() only accepts price < close.
addHighLevel("YH", YH_eff, yhStatus_eff, yhStackGroup, yhGroup, yhBridgeGroup, false)
addLowLevel ("YH", YH_eff, yhStatus_eff, yhStackGroup, yhGroup, yhBridgeGroup, false)

addHighLevel("YL", YL_eff, ylStatus_eff, ylStackGroup, ylGroup, ylBridgeGroup, false)
addLowLevel ("YL", YL_eff, ylStatus_eff, ylStackGroup, ylGroup, ylBridgeGroup, false)

//---------------------------------------------------------
// SORT LOW LADDER (NEAREST BELOW → OUTWARD)
//---------------------------------------------------------

sortLowLadder() =>
    int n = array.size(lowAnchorPrices)

    if n > 1
        for i = 0 to n - 2
            for j = i + 1 to n - 1

                float pi = array.get(lowAnchorPrices, i)
                float pj = array.get(lowAnchorPrices, j)

                if pj > pi

                    string ni = array.get(lowNames, i)
                    string nj = array.get(lowNames, j)

                    float ai = array.get(lowAnchorPrices, i)
                    float aj = array.get(lowAnchorPrices, j)

                    float ti = array.get(lowTargetPrices, i)
                    float tj = array.get(lowTargetPrices, j)

                    string si = array.get(lowStackLabels, i)
                    string sj = array.get(lowStackLabels, j)

                    bool bi = array.get(lowIsStack, i)
                    bool bj = array.get(lowIsStack, j)

                    array.set(lowNames, i, nj)
                    array.set(lowNames, j, ni)

                    array.set(lowAnchorPrices, i, aj)
                    array.set(lowAnchorPrices, j, ai)

                    array.set(lowTargetPrices, i, tj)
                    array.set(lowTargetPrices, j, ti)

                    array.set(lowStackLabels, i, sj)
                    array.set(lowStackLabels, j, si)

                    array.set(lowIsStack, i, bj)
                    array.set(lowIsStack, j, bi)

sortHighLadder()
sortLowLadder()

if shouldFreezeNow
    clearFrozenLadder()

    int highCount = array.size(highNames)

    if highCount > 0
        for i = 0 to highCount - 1
            array.push(frozenHighNames, array.get(highNames, i))
            array.push(frozenHighPrices, array.get(highAnchorPrices, i))

    int lowCount = array.size(lowNames)

    if lowCount > 0
        for i = 0 to lowCount - 1
            array.push(frozenLowNames, array.get(lowNames, i))
            array.push(frozenLowPrices, array.get(lowAnchorPrices, i))

if sessionTableFrozen
    clearLiveLadder()

    int frozenHighCount = array.size(frozenHighNames)

    if frozenHighCount > 0
        for i = 0 to frozenHighCount - 1
            array.push(highNames, array.get(frozenHighNames, i))
            array.push(highAnchorPrices, array.get(frozenHighPrices, i))
            array.push(highTargetPrices, na)
            array.push(highStackLabels, "NONE")
            array.push(highIsStack, false)

    int frozenLowCount = array.size(frozenLowNames)

    if frozenLowCount > 0
        for i = 0 to frozenLowCount - 1
            array.push(lowNames, array.get(frozenLowNames, i))
            array.push(lowAnchorPrices, array.get(frozenLowPrices, i))
            array.push(lowTargetPrices, na)
            array.push(lowStackLabels, "NONE")
            array.push(lowIsStack, false)

//---------------------------------------------------------
// MIDPOINT / 25% LOGIC BETWEEN RESOLVED LADDER LEVELS
//---------------------------------------------------------
// Uses deduped ladder anchors.
// Stacked levels count as ONE owner.
// The original Liquidity Level price remains available to activation, table, and webhook projection.
// 25/50 projections use stack extreme anchor only.
//
// IMPORTANT:
// After session lock, midpoint/exhaustion lines are frozen.
// They do NOT disappear later because a level becomes inactive,
// price crosses a level, or the ladder rebuilds.

distinctEffectiveBoundaries(float a, float b) =>
    not na(a) and not na(b) and math.abs(a - b) > tol

midpoint(float a, float b) =>
    roundToMintick((a + b) / 2.0)

exhaust25(float fromLevel, float toLevel) =>
    roundToMintick(fromLevel + ((toLevel - fromLevel) * 0.75))

ladderGapMid(float[] prices, int idx) =>
    int n = array.size(prices)
    if n > idx + 1
        float fromPrice = array.get(prices, idx)
        float toPrice   = array.get(prices, idx + 1)
        distinctEffectiveBoundaries(fromPrice, toPrice) ? midpoint(fromPrice, toPrice) : na
    else
        na

ladderGap25(float[] prices, int idx) =>
    int n = array.size(prices)
    if n > idx + 1
        float fromPrice = array.get(prices, idx)
        float toPrice   = array.get(prices, idx + 1)
        distinctEffectiveBoundaries(fromPrice, toPrice) ? exhaust25(fromPrice, toPrice) : na
    else
        na

frozenFloat(float[] arr, int idx) =>
    array.size(arr) > idx ? array.get(arr, idx) : na

// Frozen midpoint/exhaustion values.
// These are populated once, at premarket session end.
var float[] frozenHighMid50 = array.new_float()
var float[] frozenHighEx25  = array.new_float()
var float[] frozenLowMid50  = array.new_float()
var float[] frozenLowEx25   = array.new_float()

if sessionEnd(inPremarket)
    array.clear(frozenHighMid50)
    array.clear(frozenHighEx25)
    array.clear(frozenLowMid50)
    array.clear(frozenLowEx25)

    int highFreezeCount = array.size(highAnchorPrices)

    if highFreezeCount > 1
        for i = 0 to highFreezeCount - 2
            float fromPrice = array.get(highAnchorPrices, i)
            float toPrice   = array.get(highAnchorPrices, i + 1)

            bool validGap = distinctEffectiveBoundaries(fromPrice, toPrice)

            array.push(frozenHighMid50, validGap ? midpoint(fromPrice, toPrice) : na)
            array.push(frozenHighEx25,  validGap ? exhaust25(fromPrice, toPrice) : na)

    int lowFreezeCount = array.size(lowAnchorPrices)

    if lowFreezeCount > 1
        for i = 0 to lowFreezeCount - 2
            float fromPrice = array.get(lowAnchorPrices, i)
            float toPrice   = array.get(lowAnchorPrices, i + 1)

            bool validGap = distinctEffectiveBoundaries(fromPrice, toPrice)

            array.push(frozenLowMid50, validGap ? midpoint(fromPrice, toPrice) : na)
            array.push(frozenLowEx25,  validGap ? exhaust25(fromPrice, toPrice) : na)

// Legacy variable names preserved for drawing block.
// They now mean: resolved ladder gap 0 / 1 / 2, not raw named level pairs.
//
// Before premarket lock:
// - use live ladder values.
//
// After premarket lock:
// - use frozen session values only.

// High side: nearest above -> outward
float mid_LH_PMH  = sessionLocked ? frozenFloat(frozenHighMid50, 0) : ladderGapMid(highAnchorPrices, 0)
float mid_ONH_LH  = sessionLocked ? frozenFloat(frozenHighMid50, 1) : ladderGapMid(highAnchorPrices, 1)
float mid_YH_ONH  = sessionLocked ? frozenFloat(frozenHighMid50, 2) : ladderGapMid(highAnchorPrices, 2)

float ex25_PMH_LH = sessionLocked ? frozenFloat(frozenHighEx25, 0) : ladderGap25(highAnchorPrices, 0)
float ex25_LH_ONH = sessionLocked ? frozenFloat(frozenHighEx25, 1) : ladderGap25(highAnchorPrices, 1)
float ex25_ONH_YH = sessionLocked ? frozenFloat(frozenHighEx25, 2) : ladderGap25(highAnchorPrices, 2)

// Low side: nearest below -> outward
float mid_LL_PML  = sessionLocked ? frozenFloat(frozenLowMid50, 0) : ladderGapMid(lowAnchorPrices, 0)
float mid_ONL_LL  = sessionLocked ? frozenFloat(frozenLowMid50, 1) : ladderGapMid(lowAnchorPrices, 1)
float mid_YL_ONL  = sessionLocked ? frozenFloat(frozenLowMid50, 2) : ladderGapMid(lowAnchorPrices, 2)

float ex25_PML_LL = sessionLocked ? frozenFloat(frozenLowEx25, 0) : ladderGap25(lowAnchorPrices, 0)
float ex25_LL_ONL = sessionLocked ? frozenFloat(frozenLowEx25, 1) : ladderGap25(lowAnchorPrices, 1)
float ex25_ONL_YL = sessionLocked ? frozenFloat(frozenLowEx25, 2) : ladderGap25(lowAnchorPrices, 2)
//---------------------------------------------------------
// FROZEN LEVELS FOR CARRY
//---------------------------------------------------------
float PMH_frozen = PMH_eff
float PML_frozen = PML_eff
float LH_frozen  = LH_eff
float LL_frozen  = LL_eff
float ONH_frozen = ONH_eff
float ONL_frozen = ONL_eff
float YH_frozen  = YH_eff
float YL_frozen  = YL_eff

//---------------------------------------------------------
// STACK OFFSET LOGIC
//---------------------------------------------------------
applyHighOffsetDown(float base, float ref1, float ref2, float ref3, int rank) =>
    float out = base
    if not na(base)
        int matchesBefore = 0
        if rank > 0 and sameLevel(base, ref1)
            matchesBefore += 1
        if rank > 1 and sameLevel(base, ref2)
            matchesBefore += 1
        if rank > 2 and sameLevel(base, ref3)
            matchesBefore += 1
        out -= matchesBefore * stackStep
    out

applyLowOffsetUp(float base, float ref1, float ref2, float ref3, int rank) =>
    float out = base
    if not na(base)
        int matchesBefore = 0
        if rank > 0 and sameLevel(base, ref1)
            matchesBefore += 1
        if rank > 1 and sameLevel(base, ref2)
            matchesBefore += 1
        if rank > 2 and sameLevel(base, ref3)
            matchesBefore += 1
        out += matchesBefore * stackStep
    out

float PMH_live = PMH_eff
float LH_live  = LH_eff
float ONH_live = ONH_eff
float YH_live  = YH_eff

float PML_live = PML_eff
float LL_live  = LL_eff
float ONL_live = ONL_eff
float YL_live  = YL_eff

float PMH_carry = PMH_frozen
float LH_carry  = LH_frozen
float ONH_carry = ONH_frozen
float YH_carry  = YH_frozen

float PML_carry = PML_frozen
float LL_carry  = LL_frozen
float ONL_carry = ONL_frozen
float YL_carry  = YL_frozen

if stackOffset
    YH_live  := applyHighOffsetDown(YH_eff,  na,      na,      na,      0)
    ONH_live := applyHighOffsetDown(ONH_eff, YH_eff,  na,      na,      1)
    LH_live  := applyHighOffsetDown(LH_eff,  YH_eff,  ONH_eff, na,      2)
    PMH_live := applyHighOffsetDown(PMH_eff, YH_eff,  ONH_eff, LH_eff,  3)

    YH_carry  := applyHighOffsetDown(YH_frozen,  na,         na,         na,        0)
    ONH_carry := applyHighOffsetDown(ONH_frozen, YH_frozen,  na,         na,        1)
    LH_carry  := applyHighOffsetDown(LH_frozen,  YH_frozen,  ONH_frozen, na,        2)
    PMH_carry := applyHighOffsetDown(PMH_frozen, YH_frozen,  ONH_frozen, LH_frozen, 3)

    YL_live  := applyLowOffsetUp(YL_eff,  na,      na,      na,      0)
    ONL_live := applyLowOffsetUp(ONL_eff, YL_eff,  na,      na,      1)
    LL_live  := applyLowOffsetUp(LL_eff,  YL_eff,  ONL_eff, na,      2)
    PML_live := applyLowOffsetUp(PML_eff, YL_eff,  ONL_eff, LL_eff,  3)

    YL_carry  := applyLowOffsetUp(YL_frozen,  na,         na,         na,        0)
    ONL_carry := applyLowOffsetUp(ONL_frozen, YL_frozen,  na,         na,        1)
    LL_carry  := applyLowOffsetUp(LL_frozen,  YL_frozen,  ONL_frozen, na,        2)
    PML_carry := applyLowOffsetUp(PML_frozen, YL_frozen,  ONL_frozen, LL_frozen, 3)

//---------------------------------------------------------
// HIDE INACTIVE LEVELS COMPLETELY
//---------------------------------------------------------
if lhStatus_eff == "INACTIVE"
    LH_live := na
    LH_carry := na
if llStatus_eff == "INACTIVE"
    LL_live := na
    LL_carry := na
if onhStatus_eff == "INACTIVE"
    ONH_live := na
    ONH_carry := na
if onlStatus_eff == "INACTIVE"
    ONL_live := na
    ONL_carry := na
if yhStatus_eff == "INACTIVE"
    YH_live := na
    YH_carry := na
if ylStatus_eff == "INACTIVE"
    YL_live := na
    YL_carry := na

bool showLH_final  = showLH and lhStatus_eff != "INACTIVE"
bool showLL_final  = showLL and llStatus_eff != "INACTIVE"
bool showONH_final = showONH and onhStatus_eff != "INACTIVE"
bool showONL_final = showONL and onlStatus_eff != "INACTIVE"
bool showYH_final  = showYH and yhStatus_eff != "INACTIVE"
bool showYL_final  = showYL and ylStatus_eff != "INACTIVE"

//---------------------------------------------------------
// LIVE PLOTS
//---------------------------------------------------------
plot(showPMH ? PMH_live : na, title="PMH", color=color.new(color.white, 0), linewidth=1, style=plot.style_linebr)
plot(showPML ? PML_live : na, title="PML", color=color.new(color.white, 0), linewidth=1, style=plot.style_linebr)

plot(showLH_final ? LH_live : na, title="LH", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(showLL_final ? LL_live : na, title="LL", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)

plot(showONH_final ? ONH_live : na, title="ONH", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
