    if showMidpoints and not na(mid_LL_PML)
        midLine_LL_PML := line.new(time, mid_LL_PML, today1400, mid_LL_PML, xloc=xloc.bar_time, color=midpointColor, width=1, style=line.style_dotted)

    if showExhaustion25 and not na(ex25_PMH_LH)
        ex25Line_PMH_LH := line.new(time, ex25_PMH_LH, today1400, ex25_PMH_LH, xloc=xloc.bar_time, color=exhaustion25Color, width=1, style=line.style_dashed)
    if showExhaustion25 and not na(ex25_LH_ONH)
        ex25Line_LH_ONH := line.new(time, ex25_LH_ONH, today1400, ex25_LH_ONH, xloc=xloc.bar_time, color=exhaustion25Color, width=1, style=line.style_dashed)
    if showExhaustion25 and not na(ex25_ONH_YH)
        ex25Line_ONH_YH := line.new(time, ex25_ONH_YH, today1400, ex25_ONH_YH, xloc=xloc.bar_time, color=exhaustion25Color, width=1, style=line.style_dashed)

    if showExhaustion25 and not na(ex25_PML_LL)
        ex25Line_PML_LL := line.new(time, ex25_PML_LL, today1400, ex25_PML_LL, xloc=xloc.bar_time, color=exhaustion25Color, width=1, style=line.style_dashed)
    if showExhaustion25 and not na(ex25_LL_ONL)
        ex25Line_LL_ONL := line.new(time, ex25_LL_ONL, today1400, ex25_LL_ONL, xloc=xloc.bar_time, color=exhaustion25Color, width=1, style=line.style_dashed)
    if showExhaustion25 and not na(ex25_ONL_YL)
        ex25Line_ONL_YL := line.new(time, ex25_ONL_YL, today1400, ex25_ONL_YL, xloc=xloc.bar_time, color=exhaustion25Color, width=1, style=line.style_dashed)
//---------------------------------------------------------
// DYNAMIC PRICE-ACTION TABLE
//---------------------------------------------------------
var table levelTable = table.new(position.top_right, 6, 15, border_width=1)

levelImportance(string name) =>
    switch name
        "YH"  => 1
        "YL"  => 1
        "ONH" => 2
        "ONL" => 2
        "LH"  => 3
        "LL"  => 3
        "PMH" => 4
        "PML" => 4
        => 99

rowBg(string name) =>
    switch name
        "YH"  => color.new(color.green, 60)
        "ONH" => color.new(color.green, 85)
        "LH"  => color.new(color.green, 75)
        "PMH" => color.new(color.gray, 70)
        "YL"  => color.new(color.red, 60)
        "ONL" => color.new(color.red, 85)
        "LL"  => color.new(color.red, 75)
        "PML" => color.new(color.gray, 70)
        => color.black

addLevelRow(int row, string name, float truePrice, float visPrice, string state, string status, string stackLabel) =>
    table.cell(levelTable, 0, row, name, text_color=color.white, bgcolor=rowBg(name))
    table.cell(levelTable, 1, row, fmt(truePrice), text_color=color.white)
    table.cell(levelTable, 2, row, fmt(visPrice), text_color=color.white)
    table.cell(levelTable, 3, row, state, text_color=color.white)
    table.cell(levelTable, 4, row, status, text_color=color.white)
    table.cell(levelTable, 5, row, stackLabel, text_color=color.white)

addPriceRow(int row) =>
    table.cell(levelTable, 0, row, "PRICE", text_color=color.black, bgcolor=color.new(color.yellow, 0))
    table.cell(levelTable, 1, row, fmt(close), text_color=color.black, bgcolor=color.new(color.yellow, 0))
    table.cell(levelTable, 2, row, "LIVE", text_color=color.black, bgcolor=color.new(color.yellow, 0))
    table.cell(levelTable, 3, row, syminfo.ticker, text_color=color.black, bgcolor=color.new(color.yellow, 0))
    table.cell(levelTable, 4, row, "", text_color=color.black, bgcolor=color.new(color.yellow, 0))
    table.cell(levelTable, 5, row, "", text_color=color.black, bgcolor=color.new(color.yellow, 0))

clearTable() =>
    for r = 0 to 14
        for c = 0 to 5
            table.cell(levelTable, c, r, "", text_color=color.white, bgcolor=color.new(color.black, 100))

// Arrays for dynamic sorting
var string[] namesArr = array.new_string()
var float[] pricesArr = array.new_float()
var float[] displayArr = array.new_float()
var string[] statesArr = array.new_string()
var string[] statusesArr = array.new_string()
var string[] stacksArr = array.new_string()
var int[] impArr = array.new_int()

pushLevel(string name, float truePrice, float visPrice, string state, string status, string stackLabel) =>
    if not na(truePrice) and status != "INACTIVE"
        array.push(namesArr, name)
        array.push(pricesArr, truePrice)
        array.push(displayArr, visPrice)
        array.push(statesArr, state)
        array.push(statusesArr, status)
        array.push(stacksArr, stackLabel)
        array.push(impArr, levelImportance(name))

swapRows(int i, int j) =>
    string n1 = array.get(namesArr, i)
    float p1 = array.get(pricesArr, i)
    float d1 = array.get(displayArr, i)
    string s1 = array.get(statesArr, i)
    string st1 = array.get(statusesArr, i)
    string g1 = array.get(stacksArr, i)
    int im1 = array.get(impArr, i)

    array.set(namesArr, i, array.get(namesArr, j))
    array.set(pricesArr, i, array.get(pricesArr, j))
    array.set(displayArr, i, array.get(displayArr, j))
    array.set(statesArr, i, array.get(statesArr, j))
    array.set(statusesArr, i, array.get(statusesArr, j))
    array.set(stacksArr, i, array.get(stacksArr, j))
    array.set(impArr, i, array.get(impArr, j))

    array.set(namesArr, j, n1)
    array.set(pricesArr, j, p1)
    array.set(displayArr, j, d1)
    array.set(statesArr, j, s1)
    array.set(statusesArr, j, st1)
    array.set(stacksArr, j, g1)
    array.set(impArr, j, im1)

tableSide(float price) =>
    na(price) ? "NONE" : sameLevel(price, close) ? "TOUCH" : price > close ? "ABOVE" : "BELOW"

// YH/YL are roamers.
// Table side is determined by price relative to current close, not level name.
sortAbovePrice() =>
    int n = array.size(namesArr)
    if n > 1
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                bool iAbove = tableSide(array.get(pricesArr, i)) == "ABOVE"
                bool jAbove = tableSide(array.get(pricesArr, j)) == "ABOVE"

                if iAbove and jAbove
                    float pi = array.get(displayArr, i)
                    float pj = array.get(displayArr, j)
                    int ii = array.get(impArr, i)
                    int ij = array.get(impArr, j)
                    string gi = array.get(stacksArr, i)
                    string gj = array.get(stacksArr, j)

                    bool sameStack = gi != "NONE" and gi == gj
                    bool shouldSwap = pj > pi

                    if shouldSwap
                        swapRows(i, j)

sortBelowPrice() =>
    int n = array.size(namesArr)
    if n > 1
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                bool iBelow = tableSide(array.get(pricesArr, i)) == "BELOW"
                bool jBelow = tableSide(array.get(pricesArr, j)) == "BELOW"

                if iBelow and jBelow
                    float pi = array.get(pricesArr, i)
                    float pj = array.get(pricesArr, j)
                    int ii = array.get(impArr, i)
                    int ij = array.get(impArr, j)
                    string gi = array.get(stacksArr, i)
                    string gj = array.get(stacksArr, j)

                    bool sameStack = gi != "NONE" and gi == gj
                    bool shouldSwap = pj > pi

                    if shouldSwap
                        swapRows(i, j)

if barstate.islast and showTable
    clearTable()

    table.cell(levelTable, 0, 0, "LEVEL", text_color=color.white, bgcolor=color.black)
    table.cell(levelTable, 1, 0, "TRUE PRICE", text_color=color.white, bgcolor=color.black)
    table.cell(levelTable, 2, 0, "VIS", text_color=color.white, bgcolor=color.black)
    table.cell(levelTable, 3, 0, "STATE", text_color=color.white, bgcolor=color.black)
    table.cell(levelTable, 4, 0, "STATUS", text_color=color.white, bgcolor=color.black)
    table.cell(levelTable, 5, 0, "STACK", text_color=color.white, bgcolor=color.black)

    array.clear(namesArr)
    array.clear(pricesArr)
    array.clear(displayArr)
    array.clear(statesArr)
    array.clear(statusesArr)
    array.clear(stacksArr)
    array.clear(impArr)

    // Push all levels together so YH/YL can roam above or below price.
    pushLevel("YH",  YH_eff,  YH_live,  "PRIOR RTH", yhStatus_eff,  yhStackGroup)
    pushLevel("YL",  YL_eff,  YL_live,  "PRIOR RTH", ylStatus_eff,  ylStackGroup)
    pushLevel("ONH", ONH_eff, ONH_live, sessionStateText(inOvernight), onhStatus_eff, onhStackGroup)
    pushLevel("ONL", ONL_eff, ONL_live, sessionStateText(inOvernight), onlStatus_eff, onlStackGroup)
    pushLevel("LH",  LH_eff,  LH_live,  sessionStateText(inLondon), lhStatus_eff,  lhStackGroup)
    pushLevel("LL",  LL_eff,  LL_live,  sessionStateText(inLondon), llStatus_eff,  llStackGroup)
    pushLevel("PMH", PMH_eff, PMH_live, sessionStateText(inPremarket), pmhStatus_eff, pmhStackGroup)
    pushLevel("PML", PML_eff, PML_live, sessionStateText(inPremarket), pmlStatus_eff, pmlStackGroup)

    sortAbovePrice()

    int row = 1

    // Print all levels above price.
    // YH/YL are roamers, so name does not determine table side.
    for i = 0 to array.size(namesArr) - 1
        string nm = array.get(namesArr, i)
        float pr = array.get(pricesArr, i)

        if tableSide(pr) == "ABOVE"
            addLevelRow(row, nm, pr, array.get(displayArr, i), array.get(statesArr, i), array.get(statusesArr, i), array.get(stacksArr, i))
            row += 1

    addPriceRow(row)
    row += 1

    // TOUCH rows are rendered exactly once, immediately below PRICE, in
    // deterministic canonical importance order. They never enter a target ladder.
    for priority = 1 to 4
        for i = 0 to array.size(namesArr) - 1
            float pr = array.get(pricesArr, i)
            if tableSide(pr) == "TOUCH" and array.get(impArr, i) == priority
                addLevelRow(row, array.get(namesArr, i), pr, array.get(displayArr, i), array.get(statesArr, i), array.get(statusesArr, i), "TOUCH")
                row += 1

    sortBelowPrice()

    // Print all levels below price.
    // YH/YL are roamers, so name does not determine table side.
    for i = 0 to array.size(namesArr) - 1
        string nm = array.get(namesArr, i)
        float pr = array.get(pricesArr, i)

        if tableSide(pr) == "BELOW"
            addLevelRow(row, nm, pr, array.get(displayArr, i), array.get(statesArr, i), array.get(statusesArr, i), array.get(stacksArr, i))
            row += 1

    // Footer
    if row <= 12
        table.cell(levelTable, 0, row, "PM ATR%", text_color=color.white, bgcolor=color.black)
        table.cell(levelTable, 1, row, fmtPct(pmATRpct), text_color=color.white)
        table.cell(levelTable, 2, row, "5:00-6:14", text_color=color.white)
        table.cell(levelTable, 3, row, fmt(pmRange), text_color=color.white)
        table.cell(levelTable, 4, row, "", text_color=color.white)
        table.cell(levelTable, 5, row, "", text_color=color.white)
        row += 1

    if row <= 13
        table.cell(levelTable, 0, row, "Daily Range %", text_color=color.white, bgcolor=color.new(color.blue, 0))
        table.cell(levelTable, 1, row, fmtPct(dailyRangePct), text_color=color.white)
        table.cell(levelTable, 2, row, "ONH-ONL", text_color=color.white)
        table.cell(levelTable, 3, row, fmt(onRange), text_color=color.white)
        table.cell(levelTable, 4, row, "", text_color=color.white)
        table.cell(levelTable, 5, row, "", text_color=color.white)
        row += 1

    if row <= 14
        table.cell(levelTable, 0, row, "NOTE", text_color=color.white, bgcolor=color.black)
        table.cell(levelTable, 1, row, "TRUE=WEBHOOK", text_color=color.white)
        table.cell(levelTable, 2, row, stackOffset ? "VIS=OFFSET" : "VIS=TRUE", text_color=color.white)
        table.cell(levelTable, 3, row, "STACK", text_color=color.white)
        table.cell(levelTable, 4, row, fmt(stackThreshold), text_color=color.white)
        table.cell(levelTable, 5, row, stackOffset ? "ON" : "OFF", text_color=color.white)

//---------------------------------------------------------
// ENTRY AGENT TRADINGVIEW CONTEXT WEBHOOK
// OVERLAPPING STACK PAYLOAD - FINALIZED TABLE STATE
//---------------------------------------------------------
// Canonical complete-source v14 liquidity sender.

f_json_num(float x) =>
    na(x) ? "null" : str.tostring(x)

f_json_str(string x) =>
    if str.match(x, "\\x0D") != ""
        runtime.error("CANONICAL_JSON_STRING_U000D_REJECTED")

    string escaped = str.replace_all(x, "\\", "\\\\")
    escaped := str.replace_all(escaped, "\"", "\\\"")
    escaped := str.replace_all(escaped, "\n", "\\n")
    escaped := str.replace_all(escaped, "\t", "\\t")
    "\"" + escaped + "\""

f_json_bool(bool x) =>
    x ? "true" : "false"

payloadLevelNameAtIndex(int levelIdx) =>
    switch levelIdx
        0 => "YH"
        1 => "YL"
        2 => "ONH"
        3 => "ONL"
        4 => "LH"
        5 => "LL"
        6 => "PMH"
        7 => "PML"
        => "UNKNOWN"

payloadLevelPriceAtIndex(int levelIdx) =>
    switch levelIdx
        0 => YH_eff
        1 => YL_eff
        2 => ONH_eff
        3 => ONL_eff
        4 => LH_eff
        5 => LL_eff
        6 => PMH_eff
        7 => PML_eff
        => na

payloadLevelStatusAtIndex(int levelIdx) =>
    switch levelIdx
        0 => yhStatus_eff
        1 => ylStatus_eff
        2 => onhStatus_eff
        3 => onlStatus_eff
        4 => lhStatus_eff
        5 => llStatus_eff
        6 => pmhStatus_eff
        7 => pmlStatus_eff
        => "INACTIVE"

payloadTableStackLabelAtIndex(int levelIdx) =>
    switch levelIdx
        0 => yhStackGroup
        1 => ylStackGroup
        2 => onhStackGroup
        3 => onlStackGroup
        4 => lhStackGroup
        5 => llStackGroup
        6 => pmhStackGroup
        7 => pmlStackGroup
        => "NONE"

payloadLevelPriorityAtIndex(int levelIdx) =>
    switch levelIdx
        0 => 1
        1 => 1
        2 => 2
        3 => 2
        4 => 3
        5 => 3
        6 => 4
        7 => 4
        => 0

payloadDisplayHasStackLabel(string displayLabel, string stackLabel) =>
    bool found = false

    if displayLabel != "NONE"
        string[] labels = str.split(displayLabel, " + ")
        int labelCount = array.size(labels)

        if labelCount > 0
            for i = 0 to labelCount - 1
                if array.get(labels, i) == stackLabel
                    found := true

    found

payloadSingleStackGroupJson(int levelIdx) =>
    string displayLabel = payloadTableStackLabelAtIndex(levelIdx)

    if displayLabel == "NONE"
        f_json_str("NONE")
    else
        string[] labels = str.split(displayLabel, " + ")
        array.size(labels) >= 1 ? f_json_str(array.get(labels, 0)) : f_json_str("NONE")

payloadStackGroupsJsonForLevel(int levelIdx) =>
    string displayLabel = payloadTableStackLabelAtIndex(levelIdx)
    string result = "["
    bool first = true

    if displayLabel != "NONE"
        string[] labels = str.split(displayLabel, " + ")
        int labelCount = array.size(labels)

        if labelCount > 0
            for i = 0 to labelCount - 1
                if not first
                    result += ","

                result += f_json_str(array.get(labels, i))
                first := false

    result += "]"
    result

payloadExplicitStackObjectJson(string stackLabel, string side) =>
    int[] memberIndexes = array.new_int()
    float[] memberPrices = array.new_float()

    for levelIdx = 0 to 7
        string displayLabel = payloadTableStackLabelAtIndex(levelIdx)
        float levelPrice = payloadLevelPriceAtIndex(levelIdx)
        string levelStatus = payloadLevelStatusAtIndex(levelIdx)

        if levelStatus != "INACTIVE" and not na(levelPrice) and payloadDisplayHasStackLabel(displayLabel, stackLabel)
            array.push(memberIndexes, levelIdx)
            array.push(memberPrices, levelPrice)

    int memberCount = array.size(memberIndexes)

    if memberCount > 1
        for i = 0 to memberCount - 2
            for j = i + 1 to memberCount - 1
                float priceI = array.get(memberPrices, i)
                float priceJ = array.get(memberPrices, j)
                int indexI = array.get(memberIndexes, i)
                int indexJ = array.get(memberIndexes, j)
                bool samePrice = priceI == priceJ
                bool priceOutOfOrder = side == "HIGH" ? priceJ < priceI : priceJ > priceI
                bool tieOutOfOrder = samePrice and payloadLevelPriorityAtIndex(indexJ) > payloadLevelPriorityAtIndex(indexI)

                if priceOutOfOrder or tieOutOfOrder
                    array.set(memberPrices, i, priceJ)
                    array.set(memberPrices, j, priceI)
                    array.set(memberIndexes, i, indexJ)
                    array.set(memberIndexes, j, indexI)

    if memberCount < 2
        ""
    else
        string membersJson = "["

        for i = 0 to memberCount - 1
            if i > 0
                membersJson += ","

            membersJson += f_json_str(payloadLevelNameAtIndex(array.get(memberIndexes, i)))

        membersJson += "]"

        float innermostPrice = array.get(memberPrices, 0)
        float outermostPrice = array.get(memberPrices, memberCount - 1)

        "{"
         + "\"id\":" + f_json_str(stackLabel) + ","
         + "\"side\":" + f_json_str(side) + ","
         + "\"members\":" + membersJson + ","
         + "\"innermost_price\":" + f_json_num(innermostPrice) + ","
         + "\"outermost_price\":" + f_json_num(outermostPrice)
         + "}"

payloadExplicitStacksArrayJson() =>
    string result = "["
    bool firstStack = true

    // Eight source levels can form at most seven boundary-overlap groups.
    for stackNumber = 1 to 7
        string stackLabel = "HIGH " + str.tostring(stackNumber)
        string stackObject = payloadExplicitStackObjectJson(stackLabel, "HIGH")

        if stackObject != ""
            if not firstStack
                result += ","

            result += stackObject
            firstStack := false

    for stackNumber = 1 to 7
        string stackLabel = "LOW " + str.tostring(stackNumber)
        string stackObject = payloadExplicitStackObjectJson(stackLabel, "LOW")

        if stackObject != ""
            if not firstStack
                result += ","

            result += stackObject
            firstStack := false

    result += "]"
    result

payloadLevelJson(int levelIdx) =>
    string displayLabel = payloadTableStackLabelAtIndex(levelIdx)

    "{"
     + "\"price\":" + f_json_num(payloadLevelPriceAtIndex(levelIdx)) + ","
     + "\"status\":" + f_json_str(payloadLevelStatusAtIndex(levelIdx)) + ","
     + "\"stack_group\":" + payloadSingleStackGroupJson(levelIdx) + ","
     + "\"stack_groups\":" + payloadStackGroupsJsonForLevel(levelIdx) + ","
     + "\"stack_display\":" + f_json_str(displayLabel)
     + "}"

payloadLiquidityMapLevelJson(int levelIdx) =>
    string displayLabel = payloadTableStackLabelAtIndex(levelIdx)

    "{"
     + "\"name\":" + f_json_str(payloadLevelNameAtIndex(levelIdx)) + ","
     + "\"price\":" + f_json_num(payloadLevelPriceAtIndex(levelIdx)) + ","
     + "\"status\":" + f_json_str(payloadLevelStatusAtIndex(levelIdx)) + ","
     + "\"stack_group\":" + payloadSingleStackGroupJson(levelIdx) + ","
     + "\"stack_groups\":" + payloadStackGroupsJsonForLevel(levelIdx) + ","
     + "\"stack_display\":" + f_json_str(displayLabel)
     + "}"

payloadLiquidityMapLevelsArrayJson() =>
    "["
     + payloadLiquidityMapLevelJson(6) + ","
     + payloadLiquidityMapLevelJson(7) + ","
     + payloadLiquidityMapLevelJson(4) + ","
     + payloadLiquidityMapLevelJson(5) + ","
     + payloadLiquidityMapLevelJson(2) + ","
     + payloadLiquidityMapLevelJson(3) + ","
     + payloadLiquidityMapLevelJson(0) + ","
     + payloadLiquidityMapLevelJson(1)
     + "]"

// Trigger flags describe the frozen snapshot, never an individual transport
// attempt. They therefore remain byte-identical on every recovery replay.
bool frozenSnapshotIsPremarketEnd = true
bool isRecurringUpdate = false

buildMidpointsJson(string[] names, float[] prices) =>
    string out = ""

    int nameCount = array.size(names)
    int priceCount = array.size(prices)
    int n = math.min(nameCount, priceCount)

    if sessionLocked and n > 1
        for i = 0 to n - 2
            string fromName = array.get(names, i)
            string toName = array.get(names, i + 1)
            float fromPrice = array.get(prices, i)
            float toPrice = array.get(prices, i + 1)
            bool validGap = notStacked(fromPrice, toPrice)
            float mid50 = validGap ? midpoint(fromPrice, toPrice) : na
            string key = fromName + "_" + toName

            out += (str.length(out) > 0 ? "," : "")
            out += "\"" + key + "\":" + f_json_num(mid50)

    out

string highMidpointsJson = buildMidpointsJson(frozenHighNames, frozenHighPrices)
string lowMidpointsJson = buildMidpointsJson(frozenLowNames, frozenLowPrices)

string midpointsJson =
     "\"midpoints\":{"
     + highMidpointsJson
     + (str.length(highMidpointsJson) > 0 and str.length(lowMidpointsJson) > 0 ? "," : "")
     + lowMidpointsJson
     + "}"

buildExhaustionJson(string[] names, float[] prices, string side) =>
    string out = ""

    int nameCount = array.size(names)
    int priceCount = array.size(prices)
    int n = math.min(nameCount, priceCount)

    if sessionLocked and n > 1
        for i = 0 to n - 2
            string fromName = array.get(names, i)
            string toName = array.get(names, i + 1)
            float fromPrice = array.get(prices, i)
            float toPrice = array.get(prices, i + 1)
            bool validGap = notStacked(fromPrice, toPrice)
            float mid50 = validGap ? midpoint(fromPrice, toPrice) : na
            float rem25 = validGap ? exhaust25(fromPrice, toPrice) : na
            string key = fromName + "_" + toName

            out += (str.length(out) > 0 ? "," : "")
            out += "\"" + key + "\":{\"side\":\"" + side + "\",\"mid_50\":" + f_json_num(mid50) + ",\"remaining_25\":" + f_json_num(rem25) + "}"

    out

string highExhaustionJson = buildExhaustionJson(frozenHighNames, frozenHighPrices, "high")
string lowExhaustionJson = buildExhaustionJson(frozenLowNames, frozenLowPrices, "low")

string exhaustionJson =
     "\"exhaustion_boundaries\":{"
     + highExhaustionJson
     + (str.length(highExhaustionJson) > 0 and str.length(lowExhaustionJson) > 0 ? "," : "")
     + lowExhaustionJson
     + "}"

// Snapshot identity belongs to the governed 06:15 lock, not the bar that
// happens to transport a recovery copy later in the session.
string canonicalSourceTimestamp = not na(today0615) ? str.format_time(today0615, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") : ""
string canonicalSessionDate = not na(sessionTradingDay_lock) ? str.format_time(sessionTradingDay_lock, "yyyy-MM-dd", "UTC") : ""

bool canonicalPayloadReady =
     timeframe.isminutes and
     timeframe.multiplier == 1 and
     barstate.isconfirmed and
     tzInput == canonicalTimeZone and
     sessionLocked and
     not na(sessionTradingDay_lock) and
     time_tradingday == sessionTradingDay_lock and
     str.length(canonicalSourceTimestamp) > 0 and
     str.length(canonicalSessionDate) == 10 and
     not na(sessionLockPrice_eff) and
     not na(stackThreshold_eff) and
     not na(atr1m14) and
     not na(dailyATR14)

// Freeze the complete canonical JSON once. Later delivery attempts reuse this
// exact string rather than rebuilding from mutable telemetry or bar time.
bool canonicalSnapshotReady = canonicalPayloadReady and str.length(frozenCanonicalPayload) == 0

if canonicalSnapshotReady
    string explicitStacksJson = payloadExplicitStacksArrayJson()
    string liquidityMapLevelsJson = payloadLiquidityMapLevelsArrayJson()

    string levelsJson =
         "\"levels\":{"
         + "\"PMH\":" + payloadLevelJson(6) + ","
         + "\"PML\":" + payloadLevelJson(7) + ","
         + "\"LH\":" + payloadLevelJson(4) + ","
         + "\"LL\":" + payloadLevelJson(5) + ","
         + "\"ONH\":" + payloadLevelJson(2) + ","
         + "\"ONL\":" + payloadLevelJson(3) + ","
         + "\"YH\":" + payloadLevelJson(0) + ","
         + "\"YL\":" + payloadLevelJson(1)
         + "}"

    string entryAgentPayload =
         "{"
         + "\"source\":\"tradingview_level_helper\","
         + "\"version\":\"v14_canonical_liquidity_sender\","
         + "\"context_mode\":\"locked_levels_session_snapshot\","
         + "\"timestamp\":" + f_json_str(canonicalSourceTimestamp) + ","
         + "\"session_date\":" + f_json_str(canonicalSessionDate) + ","
         + "\"session_locked\":" + f_json_bool(sessionLocked) + ","
         + "\"locked\":" + f_json_bool(sessionLocked) + ","
         + "\"is_premarket_end\":" + f_json_bool(frozenSnapshotIsPremarketEnd) + ","
         + "\"is_recurring_update\":" + f_json_bool(isRecurringUpdate) + ","
         + "\"price_is_true_level\":true,"
         + "\"display_offsets_applied_to_chart_only\":" + f_json_bool(stackOffset) + ","
         + "\"symbol\":" + f_json_str(syminfo.ticker) + ","
         + "\"time_zone\":" + f_json_str(canonicalTimeZone) + ","
         + "\"timeframe\":" + f_json_str(timeframe.period) + ","
         + "\"atr_1m_14\":" + f_json_num(atr1m14) + ","
         + "\"daily_atr14\":" + f_json_num(dailyATR14) + ","
         + "\"stack_threshold\":" + f_json_num(stackThreshold_eff) + ","
         + "\"stack_threshold_pct\":" + f_json_num(stackAtrPct) + ","
         + "\"session_lock_price\":" + f_json_num(sessionLockPrice_eff) + ","
         + "\"pm_atr_pct\":" + f_json_num(pmATRpct) + ","
         + "\"daily_range_pct\":" + f_json_num(dailyRangePct) + ","
         + levelsJson + ","
         + "\"stacks\":" + explicitStacksJson + ","
         + "\"liquidity_map\":{\"levels\":" + liquidityMapLevelsJson + ",\"stacks\":" + explicitStacksJson + "},"
         + midpointsJson + ","
         + exhaustionJson
         + "}"

    // Runtime canonical literal integrity gate. A malformed sender identity must
    // fail closed before alert(), never reach the authenticated receiver.
    string canonicalSourceLiteral = "\"source\":\"tradingview_level_helper\""
    string canonicalVersionLiteral = "\"version\":\"v14_canonical_liquidity_sender\""
    string canonicalContextModeLiteral = "\"context_mode\":\"locked_levels_session_snapshot\""
    string canonicalTimeZoneLiteral = "\"time_zone\":\"America/Los_Angeles\""
    bool canonicalPayloadLiteralIntegrity =
         str.contains(entryAgentPayload, canonicalSourceLiteral)
         and str.contains(entryAgentPayload, canonicalVersionLiteral)
         and str.contains(entryAgentPayload, canonicalContextModeLiteral)
         and str.contains(entryAgentPayload, canonicalTimeZoneLiteral)
         and not str.contains(entryAgentPayload, "\\r")

    if canonicalPayloadLiteralIntegrity
        frozenCanonicalPayload := entryAgentPayload
        frozenCanonicalSourceTimestamp := canonicalSourceTimestamp
    else
        log.error("CANONICAL_PAYLOAD_LITERAL_INTEGRITY_FAILED")
        runtime.error("CANONICAL_PAYLOAD_LITERAL_INTEGRITY_FAILED")

// Alert attempts are transport policy only. A late-created alert gets one
// immediate confirmed realtime catch-up; an already-running alert then emits
// on fixed wall-clock five-minute boundaries through the 14:00 endpoint.
bool frozenSessionDeliveryReady =
     timeframe.isminutes and
     timeframe.multiplier == 1 and
     barstate.isconfirmed and
     barstate.isrealtime and
     tzInput == canonicalTimeZone and
     sessionLocked and
     not na(sessionTradingDay_lock) and
     time_tradingday == sessionTradingDay_lock and
     time <= today1400 and
     str.length(frozenCanonicalPayload) > 0 and
     str.length(frozenCanonicalSourceTimestamp) > 0

bool initialSnapshotDelivery = frozenSessionDeliveryReady and not sessionTableSent
bool recoveryMinuteAligned = minute(time, tzInput) % recoveryCadenceMinutes == 0
bool alignedRecoveryDelivery =
     frozenSessionDeliveryReady and
     sessionTableSent and
     time > today0615 and
     recoveryMinuteAligned and
     (na(lastRecoveryDeliveryBarTime) or lastRecoveryDeliveryBarTime != time)

bool canonicalDeliveryReady = initialSnapshotDelivery or alignedRecoveryDelivery

if canonicalDeliveryReady
    alert(frozenCanonicalPayload, alert.freq_once_per_bar_close)
    sessionTableSent := true
    lastRecoveryDeliveryBarTime := time
