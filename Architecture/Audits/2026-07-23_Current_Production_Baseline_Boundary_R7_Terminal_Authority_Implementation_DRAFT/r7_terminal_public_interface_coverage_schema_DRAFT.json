{
  "$id": "https://randle.ai/schemas/r7-terminal-public-interface-coverage-7.1.0-draft.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "R7_REAL_PUBLIC_INTERFACE_COVERAGE"
    },
    "authority_status": {
      "const": "IMPLEMENTATION_EVIDENCE_NOT_ACCEPTANCE"
    },
    "case_count": {
      "const": 178
    },
    "case_definition_git_blob": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "case_definition_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "case_execution_count": {
      "minimum": 178,
      "type": "integer"
    },
    "expectation_git_blob": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "expectation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expected_acceptance_counts": {
      "additionalProperties": false,
      "properties": {
        "ACCEPTED": {
          "const": 20
        },
        "REJECTED": {
          "const": 158
        }
      },
      "required": [
        "ACCEPTED",
        "REJECTED"
      ],
      "type": "object"
    },
    "interface_counts": {
      "additionalProperties": {
        "minimum": 1,
        "type": "integer"
      },
      "minProperties": 1,
      "type": "object"
    },
    "matrix_execution_count": {
      "minimum": 2,
      "type": "integer"
    },
    "r7i_b01_attack_count": {
      "const": 25
    },
    "reconciliation_count": {
      "minimum": 1,
      "type": "integer"
    },
    "requirement_counts": {
      "additionalProperties": {
        "minimum": 1,
        "type": "integer"
      },
      "minProperties": 15,
      "type": "object"
    },
    "schema_version": {
      "const": "7.1.0-DRAFT"
    },
    "status": {
      "const": "PASS"
    }
  },
  "required": [
    "artifact_type",
    "authority_status",
    "case_definition_git_blob",
    "case_definition_sha256",
    "case_count",
    "case_execution_count",
    "expected_acceptance_counts",
    "expectation_git_blob",
    "expectation_sha256",
    "interface_counts",
    "matrix_execution_count",
    "reconciliation_count",
    "requirement_counts",
    "r7i_b01_attack_count",
    "schema_version",
    "status"
  ],
  "title": "R7 real public-interface coverage summary",
  "type": "object"
}
