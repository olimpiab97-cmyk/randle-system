{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:randle:r7:unit2:upgrade-policy:2.0.0",
  "title": "R7 Unit 2 upgrade-authority policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","authority_bindings","authorization_expiration","authorization_scope_sha256","bootstrap_authority","dependency_manifest_sha256","fixed_roots","host_binding","installer_script_sha256","interface_version","key","ledger_id","minimum_terminal_version","operation_allowlist","preflight_baseline_sha256","protocol_version","provisioning_nonce","provisioning_script_sha256","public_certificate_sha256","required_components","revoked_component_sha256","rollback_constraints","schema_version","service","source_bindings","target_bindings","threat_model","transition_nonce","transition_plan_sha256","upgrade_client_sha256","upgrade_probe_sha256","upgrade_public_verifier_sha256","volume_identity"],
  "properties": {
    "artifact_type": {"const":"R7_UNIT2_SEPARATE_UPGRADE_AUTHORITY_POLICY"},
    "bootstrap_authority": {"const":"EXPLICIT_R7_REMEDIATION_UNIT_2_AUTHORIZATION"},
    "interface_version": {"const":"1.0.0"},
    "protocol_version": {"const":"4.0"},
    "schema_version": {"const":"2.0.0"},
    "authority_bindings": {"type":"object"},
    "target_bindings": {"type":"object"},
    "rollback_constraints": {"type":"object"},
    "threat_model": {"type":"object"},
    "authorization_expiration": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"},
    "authorization_scope_sha256": {"$ref":"#/$defs/sha256"},
    "dependency_manifest_sha256": {"$ref":"#/$defs/sha256"},
    "installer_script_sha256": {"$ref":"#/$defs/sha256"},
    "ledger_id": {"$ref":"#/$defs/sha256"},
    "preflight_baseline_sha256": {"$ref":"#/$defs/sha256"},
    "provisioning_script_sha256": {"$ref":"#/$defs/sha256"},
    "public_certificate_sha256": {"$ref":"#/$defs/sha256"},
    "transition_plan_sha256": {"$ref":"#/$defs/sha256"},
    "upgrade_client_sha256": {"$ref":"#/$defs/sha256"},
    "upgrade_probe_sha256": {"$ref":"#/$defs/sha256"},
    "upgrade_public_verifier_sha256": {"$ref":"#/$defs/sha256"},
    "minimum_terminal_version": {"const":"4.0.0-REMEDIATION"},
    "provisioning_nonce": {"$ref":"#/$defs/guid"},
    "transition_nonce": {"$ref":"#/$defs/guid"},
    "volume_identity": {"type":"string","minLength":8,"maxLength":64},
    "fixed_roots": {"type":"array","minItems":6,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "operation_allowlist": {"const":["AUTHORIZE_TERMINAL_TRANSITION","GET_AUTHORIZATION","GET_HEALTH","GET_PUBLIC_IDENTITY"]},
    "revoked_component_sha256": {"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/sha256"}},
    "required_components": {"type":"array","minItems":13,"items":{"$ref":"#/$defs/component"}},
    "host_binding": {"type":"object","additionalProperties":false,"required":["checkpoint_sha256","host_identity","terminal_interface","terminal_ledger_id","terminal_ledger_root","terminal_ledger_sequence","terminal_policy_sha256","terminal_public_trust_sha256","terminal_service_binary_sha256","terminal_service_name","terminal_service_sid","volume_identity"],"properties":{"checkpoint_sha256":{"$ref":"#/$defs/sha256"},"host_identity":{"$ref":"#/$defs/sha256"},"terminal_interface":{"const":"3.0.0-DRAFT"},"terminal_ledger_id":{"$ref":"#/$defs/sha256"},"terminal_ledger_root":{"$ref":"#/$defs/sha256"},"terminal_ledger_sequence":{"const":678},"terminal_policy_sha256":{"$ref":"#/$defs/sha256"},"terminal_public_trust_sha256":{"$ref":"#/$defs/sha256"},"terminal_service_binary_sha256":{"$ref":"#/$defs/sha256"},"terminal_service_name":{"const":"RandleTerminalAuthority"},"terminal_service_sid":{"type":"string"},"volume_identity":{"type":"string"}}},
    "key": {"type":"object","additionalProperties":false,"required":["algorithm","export_policy","key_unique_name","provider","scope","signature_algorithm"],"properties":{"algorithm":{"const":"RSA-3072"},"export_policy":{"const":"NONEXPORTABLE"},"key_unique_name":{"type":"string","minLength":1},"provider":{"const":"Microsoft Software Key Storage Provider"},"scope":{"const":"LocalMachine"},"signature_algorithm":{"const":"RSA-PSS-SHA256"}}},
    "service": {"type":"object","additionalProperties":false,"required":["account","denied_logon_rights","name","pipe","required_privileges","sid","sid_type"],"properties":{"account":{"const":"NT SERVICE\\RandleTerminalUpgradeAuthority"},"denied_logon_rights":{"const":["SeDenyInteractiveLogonRight","SeDenyRemoteInteractiveLogonRight"]},"name":{"const":"RandleTerminalUpgradeAuthority"},"pipe":{"const":"RandleAI.TerminalUpgradeAuthority.v1"},"required_privileges":{"const":["SeChangeNotifyPrivilege"]},"sid":{"type":"string"},"sid_type":{"const":"RESTRICTED"}}},
    "source_bindings": {"type":"object"}
  },
  "$defs": {
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "guid": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "component": {"type":"object","additionalProperties":false,"required":["final_path","role","sha256","staging_relative_path"],"properties":{"final_path":{"type":"string","minLength":3},"role":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"},"staging_relative_path":{"type":"string","minLength":1,"pattern":"^(?!.*\\.\\.).+$"}}}
  }
}
